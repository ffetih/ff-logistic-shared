<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Parent is ff-base-parent from ff-logistic-base, installed in the local Maven repo.
        relativePath is empty on purpose: this module does not live in that repository.
    -->
    <parent>
        <groupId>com.siose.ff</groupId>
        <artifactId>ff-base-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <!--
        What goes out on Kafka, written once: one example message per topic, and the check every
        producer's test runs against what it really sends. Both implementations run the same check,
        so a reader cannot tell which side sent a message. Used in test scope; no Spring in it.
    -->
    <groupId>com.siose.ff</groupId>
    <artifactId>ff-contracts</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>FF Logistic - Event contracts</name>
    <description>The Kafka topics, an example message for each, and the check both implementations run.</description>

    <dependencies>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
