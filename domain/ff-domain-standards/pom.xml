<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.siose.ff</groupId>
        <artifactId>ff-base-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <!--
        A domain core (decision 2): the logistics standards every other area may use. Pure functions,
        no Spring, no database: it depends on nothing of the business, and on nothing at run time.
    -->
    <groupId>com.siose.ff</groupId>
    <artifactId>ff-domain-standards</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>FF Logistic - Domain - Standards</name>
    <description>Logistics standards as pure functions: GS1 identifiers, ISO 6346 container codes, transport modes and their emission factors, distances.</description>

    <dependencies>
        <!-- package-info.java: the module's boundaries, which Spring Modulith checks in the modulith -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
